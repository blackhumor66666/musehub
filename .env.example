# ===== 基础路径 =====
# 数据目录(数据库/日志/暂存)
DATA_DIR=./data
# 音乐库根目录(即 Navidrome 扫描的目录)
# NAS 场景可以填 UNC 路径: //DXP4800-79F5/music
MUSIC_DIR=./music

# ===== 同步策略 =====
# 全量同步周期(分钟)
SYNC_INTERVAL_MINUTES=60
# 本地扫描(检测文件被删)周期(分钟)
RECONCILE_INTERVAL_MINUTES=10
# 试运行: true=只观察记录, 不下载不删除. 首次强烈建议 true
DRY_RUN=true
# 删除策略: never=永不删本地文件 | managed_only=只删本程序下载的(推荐) | mirror=严格镜像歌单
DELETE_POLICY=managed_only
# 本地文件被删后, 是否自动去平台取消收藏
PUSH_UNFAVORITE=true
# 并发下载数
DOWNLOAD_CONCURRENCY=2
# 每轮最多下载多少首
MAX_DOWNLOADS_PER_CYCLE=50

# ===== 网易云 =====
# 浏览器登录 music.163.com 后, 复制 Cookie 里完整的值(至少包含 MUSIC_U 和 __csrf)
NETEASE_COOKIE=
# 音质回退链: standard/higher/exhigh/lossless/hires/jyeffect/sky/jymaster
NETEASE_QUALITY=lossless,exhigh,higher,standard

# ===== QQ 音乐 =====
# y.qq.com 登录后的 Cookie(需要包含 uin 和 qqmusic_key/qm_keyst)
QQ_COOKIE=
# QQ 号(一般能从 Cookie 的 uin 自动解析, 解析不出再填)
QQ_UIN=
# 音质: m500=128k mp3, m800=320k mp3, f000=flac, rs01=hires
QQ_QUALITY=f000,m800,m500
# 『我喜欢』歌单的 dissid(QQ 的收藏歌单比较特殊, 自检时会提示去哪里找)
# 在 y.qq.com 打开你的"我喜欢"歌单, 地址栏 /playlist/<数字> 就是它
QQ_FAVORITE_DISSID=

# ===== Navidrome =====
NAVIDROME_URL=http://192.168.1.100:4533
NAVIDROME_USERNAME=admin
NAVIDROME_PASSWORD=
# 镜像到播放器的歌单名前缀, 例如 "[自动] " (留空则不加)
NAVIDROME_PLAYLIST_PREFIX=

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
# 你的数字用户 ID, 多个用逗号分隔; 留空=仅自己可见的命令谁都能用(不推荐)
ADMIN_USER_ID=
# 国内服务器需要代理时填写, 如 http://192.168.1.5:7890
TELEGRAM_PROXY=

# ===== Web 面板 =====
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_USERNAME=admin
# 留空 = 不启用登录(仅限本机访问时)
WEB_PASSWORD=
